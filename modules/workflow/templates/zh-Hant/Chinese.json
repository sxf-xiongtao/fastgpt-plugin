            "key": "code",
            "renderTypeList": [
              "custom"
            ],
            "label": "",
            "value": "function main({svg_str}){\n\n    // 使用正則表達式匹配代碼塊中的內容\n    const match = svg_str.match(/```[\\w]*\\n([\\s\\S]*?)```/);\n\n    if (!match) {\n        // 如果沒有匹配到代碼塊，返回一個錯誤信息或空結果\n        return {\n            result: null,\n            error: \"未找到有效的代碼塊標記。\"\n        };\n    }\n\n    // 提取代碼塊中的 SVG 內容\n    const extractedSvg = match[1].trim();\n    \n    const base64 = strToBase64(extractedSvg,'data:image/svg+xml;base64,')\n\n    return {\n        result: base64\n    }\n}",
